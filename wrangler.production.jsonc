{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "angeles-studio",
  "account_id": "43f8d75bcf1cb80313616876155f09e0",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "angeles-studio-db",
      "database_id": "dd667116-68d1-410f-a46e-8a6e45fd979b",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://angeles-studio.angelesstudioperu.workers.dev",
    "SITE_LAUNCH_READY": "false"
  },
  "observability": {
    "enabled": true
  }
}
