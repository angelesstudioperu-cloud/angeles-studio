{
  "name": "angeles-studio-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test app/lib/booking-time.test.mjs",
    "db:generate": "drizzle-kit generate",
    "cf:prepare": "node scripts/prepare-cloudflare-config.mjs",
    "cf:db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "cf:deploy": "npm run build && npm run cf:prepare && wrangler deploy --cwd dist/server --config wrangler.json",
    "qa": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261018.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "type": "module"
}
